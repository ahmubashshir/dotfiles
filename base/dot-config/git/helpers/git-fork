#!/bin/bash
exec 3> /dev/null
set -o pipefail -Cfupr
#### Remotes Implementation Section ###
function identify_remote
{
	local url remote provider host

	url="$(git remote get-url "$1")"
	[[ -n "$url" ]] || return 1
	IFS=' ' read -r host remote < <(parse_git_remote "$url")

	provider=$(get_config "$host" provider --default '')
	if [[ -z $provider ]]; then
		case "$host" in
			codeberg.org) provider=codeberg ;;
			github.com | github.*) provider=github ;;
			gitlab.* | *.gitlab.*) provider=gitlab ;;
			*) provider=unknown ;;
		esac
	fi

	printf '%s %s %s\n' "$provider" "$host" "$remote"
}

# Codeberg
function codeberg.api_call
{
	AUTH=basic api_call codeberg.org/api/v1 "$@"
}

function codeberg.user
{
	codeberg.api_call user .login
}

function codeberg.fork
{
	local domain="$1" user="$2" owner="$3" repo="$4" upstream="$5"

	json \
		:name "$repo" \
		:organization "$owner" \
		| codeberg.api_call "repos/$upstream/forks" '.' \
			-H 'Content-Type: application/json' \
			-X POST --data @- \
		| api_if_error
}

## GitHub
function github.api_call
{
	local domain="$1" apibase defversion
	shift

	case "$domain" in
		github.com)
			apibase=api.github.com
			defversion=2026-03-10
			;;
		*)
			apibase="$domain/api/v3"
			defversion=2022-11-28
			;;
	esac

	AUTHDOMAIN="$domain" api_call "$apibase" "$@" \
		-H "X-GitHub-Api-Version: $(
			get_config "$domain" apiVersion --default "$defversion"
		)"
}

function github.user
{
	local domain="$1"
	github.api_call "$domain" user .login
}

function github.fork
{
	local domain="$1" user="$2" owner="$3" repo="$4" upstream="$5"
	[[ "$user" != "$owner" ]] || unset owner

	json \
		:name "$repo" \
		:organization "${owner-}" \
		:default_branch_only :true \
		| github.api_call "$domain" "repos/$upstream/forks" . \
			-H 'Content-Type: application/json' \
			-X POST --data @- \
		| api_if_error || return 1

	github.wait_fork "$domain" "${owner:-$user}/$repo"
}

function github.wait_fork
{
	local domain="$1" repo="$2" start now
	start="$(date +%s)"
	while ! repo_exists "https://$domain/$repo"; do
		now="$(date +%s)"

		if (((now - start) <= 300)); then
			sleep 3
			continue
		fi

		message '\e[31m ! \e[0mFork did not finish in 5 minutes...'
		message '\e[31m ! \e[0m  please contact GitHub Support...'
		return 1
	done
}

function github.post
{
	remote_config upstream gh-resolved base
}

## GitLab
function gitlab.api_call
{
	local domain="$1"
	shift

	api_call "$domain/api/v4" "$@"
}

function gitlab.user
{
	gitlab.api_call "$1" user .username
}

function gitlab.fork
{
	local domain="$1" user="$2" owner="$3" repo="$4" upstream="$5"

	json \
		:name "$repo" \
		:namespace_path "$owner" \
		:mr_default_target_self :false \
		| gitlab.api_call "$domain" "projects/$(asuri "$upstream")/fork" . \
			-H 'Content-Type: application/json' \
			-X POST --data @- \
		| api_if_error || return 1

	gitlab.wait_import "$domain" "$owner/$repo"
}

function gitlab.wait_import
{
	local domain="$1" repo="$2" status
	while api_read status gitlab.api_call "$domain" "projects/$(asuri "$repo")/import" .import_status; do
		case "$status" in
			'' | none | finished) break ;;
			scheduled | started) sleep 3 ;;
			failed) return 1 ;;
		esac
	done
}

function gitlab.post
{
	remote_config upstream glab-resolved base
	remote_config origin glab-resolved head
}

### Script Utils Section ###
function require
{
	local missing=()

	for cmd in "$@"; do
		command -v "$cmd" >&3 2>&1 || missing+=("$cmd")
	done

	if ((${#missing[@]})); then
		message '\e[31m\e[1m ! \e[0mMissing dependencies:'
		message '   - %s' "${missing[@]}"
		return 1
	fi
}

function message
{
	local template
	template="$1"
	shift
	# shellcheck disable=SC2059
	printf "$template\\n" "$@" >&2
}

function repo_exists
{
	git ls-remote -q "$1" HEAD >&3 2>&1
}

function get_config
{
	local section="$1" key="$2"
	shift 2
	git config get "$@" "fork.$section.$key"
}

function repostrip
{
	local strip="$1" filter
	printf -v filter '1{s#\\.git$##;s#^[a-z]+://##;s#^[^/]+%s(.+)$#\\1#gp}' "$strip"
	sed -nE "$filter"
}

function creds
{
	printf 'protocol=https\nhost=%s\nusername=%s\n' "$1" "$2" \
		| git credential fill \
		| (
			declare -A creds
			while IFS='=' read -r key val; do
				creds["$key"]="$val"
			done
			echo "${creds["username"]}:${creds["password"]}"
		)
}

function asuri
{
	jq -nc -r '$ARGS.positional[] | @uri' --args "$@"
}

function api_if_error
{
	jq -r $'if select(.message) then ("\e[31m ! \e[0m\(.message)\n" |halt_error(1)) else halt end'
}

function api_read
{
	read -r "$1" < <(
		shift
		"$@"
	)
}

function api_call
{
	local endpoint="$1" path="$2" jq="$3" user token
	shift 3

	IFS=: read -r user token < <(
		read -r user < <(git config --get "credential.https://${AUTHDOMAIN:-${endpoint%%/*}}.username")
		creds "${endpoint%%/*}" "$user"
	)

	[[ "$token" ]] || return 1

	case "${AUTH-bearer}" in
		basic)
			[[ -z "$user" ]] \
				|| set -- --expand-user '{{user}}:{{token}}' "$@"
			;;
		bearer)
			set -- --expand-oauth2-bearer '{{token}}' "$@"
			;;
	esac
	[[ "${AUTH-unset}" == "unset" ]] || unset AUTH

	set -- --variable '%user' --variable '%token' "$@"

	user="$user" token="$token" \
		curl --disable -s \
		--fail-with-body \
		-H 'Accept: application/json' "$@" \
		"https://$endpoint/$path" \
		| jq -r "$jq"
}

parse_git_remote()
{
	local url="$1" remote host user proto port
	[[ -n "$url" ]] || return 1
	proto="${url%%://*}"
	host="${url#*://}"
	host="${host%%/*}"

	if [[ "$host" == *@* ]]; then
		user="${host%%@*}"
		host="${host#*@}"
	fi
	if [[ $url == *://* && "$host" == *:* ]]; then
		port="${host#*:}"
		port="${port%%/*}"
		host="${host%%:*}"
	else
		host="${host%%:*}"
	fi

	case "$url" in
		*://*)
			remote="${proto}://"
			[[ -z "${user-}" ]] || remote+="$user@"
			remote+="$host"
			[[ -z "${port-}" ]] || remote+=":$port"
			remote+='/'
			;;
		*@*:*)
			remote="${user}@${host}:"
			;;
		*)
			remote="unknown"
			;;
	esac
	echo "$host $remote"
}

function remote_config
{
	local key val remote tkey tval
	remote="$1"
	tkey="$2"
	tval="$3"
	while read -r key val; do
		case "$key:$val" in
			remote.*.$tkey:$tval) return ;;
		esac
	done < <(git config --get-regexp 'remote\..*\.'"$tkey")

	git config "remote.$remote.$tkey" "$tval"

}

function needs_post
{
	[[ $(type -t "$1.post") == "function" ]]
}

function get_arg
{
	local match arg
	match="$1"
	shift

	while (($# > 0)); do
		arg="$1"
		shift
		if [[ $arg == "$match" ]]; then
			if [[ -z ${1-} ]]; then
				return $((BOOLEAN != 1))
			else
				echo "$1"
			fi
			return 0
		fi
	done
	return 1
}

function jsonlist
{
	local template
	local -a args
	template='[]'
	while (($# > 0)); do
		if [[ $1 == :* ]]; then
			args+=(--argjson)
			template+=" + [\$arg$#]"
		else
			args+=(--arg)
			template+=" + if (\$arg$#|length) > 0 then [\$arg$#] else [] end"
		fi
		args+=("arg$#" "${1#:}")
		shift
	done

	: | jq -nc "$template" "${args[@]}"
}

function json
{
	local template
	local -a args
	template='{}'
	while (($# > 0)); do
		if [[ $1 == :* ]]; then
			if [[ $2 == :* ]]; then
				args+=(--argjson)
				template+=" + {${1#:}: \$${1#:}}"
			else
				args+=(--arg)
				template+=" + if (\$${1#:}|length) > 0 then {${1#:}: \$${1#:}} else {} end"
			fi
			args+=("${1#:}" "${2#:}")
			shift
		else
			args+=("$1")
		fi
		shift
	done

	: | jq -nc "$template" "${args[@]}"
}

function fork_setup
{
	local default
	read -r default < <(
		git symbolic-ref --short refs/remotes/upstream/HEAD \
			| cut -d/ -f2-
	)

	git config "branch.$default.remote" upstream
	git config "branch.$default.pushRemote" origin
	git config remote.pushDefault origin
	message '\e[32m\e[1m + \e[0mFork remotes configured...'
}

function create_fork
{
	local org repo user upstream owner
	local provider="$1" domain="$2" remote="$3"
	shift 3

	read -r user < <("$provider.user" "$domain")
	read -r upstream < <(
		git remote get-url upstream \
			| repostrip '[/:]/?'
	)
	read -r repo < <(
		! get_arg --name "$@" || exit
		git remote get-url upstream \
			| repostrip '.+/'
	)
	read -r org < <(
		! get_arg --org "$@" || exit
		get_config "$domain/$user" org
	)

	if [[ -z "$user" ]]; then
		message '\e[31m\e[1m ! \e[0mFailed to authenticate with \e[1m%s\e[0m...' "$domain"
		return 1
	fi

	owner="${org:-$user}"
	if ! repo_exists "$remote$owner/$repo"; then
		message '\e[32m\e[1m > \e[0mForking \e[1m%s\e[0m...' "$upstream"
		"$provider.fork" "$domain" "$user" "$owner" "$repo" "$upstream" || return
		message '\e[32m\e[1m + \e[0mForked \e[1m%s\e[0m' "$owner/$repo"
	else
		message '\e[32m\e[1m + \e[0mFork exists \e[1m%s\e[0m' "$owner/$repo"
	fi

	case "$provider" in
		gitlab) repo+='.git' ;;
	esac

	if repo_exists "$remote$owner/$repo"; then
		git remote add origin "$remote$owner/$repo"
		message '\e[32m\e[1m + \e[0mRemote origin added...'
	fi

	if needs_post "$provider"; then
		message '\e[32m\e[1m + \e[0mApplying post-fork configurations...'
		"$provider.post" "$domain" "$owner" "$repo"
	fi
}

function rollback_failure
{
	trap ':' INT TERM QUIT EXIT
	if ! git remote | grep -xqw origin; then
		message '\e[31m\e[1m ! \e[0mFork failed, origin remote restored...'
		git remote rename upstream origin
		exit
	fi
	trap '-' INT TERM QUIT EXIT
}

if [[ ${1-} == "help" ]] || BOOLEAN=1 get_arg -h "$@" || BOOLEAN=1 get_arg --help "$@"; then
	cat << 'EOF'
Usage: git fork [OPTIONS]

Fork the upstream remote into your account (or org) and set up origin + tracking.

OPTIONS
  --name <NAME>     Custom repository name for the fork (default: same as upstream)
  --org <ORG>       Fork under the given organization instead of your user account
  --info            Show info about authenticated user and current repo

  -h, --help, help  Show this help message

SUPPORTED PROVIDERS
  GitHub, GitLab, Codeberg

AUTHENTICATION
  Uses `git credential` (respects whatever helper you have configured:
  store, cache, manager, osxkeychain, etc.).

EXAMPLES
  $ git fork
  $ git fork --org myteam
  $ git fork --name my-cool-fork
EOF
	exit 0
fi

require git curl jq || exit 1

if BOOLEAN=1 get_arg --info "$@"; then
	read -r provider domain remote < <(identify_remote origin)
	if [[ $provider == unknown ]]; then
		message '\e[31m\e[1m ! \e[0mUnknown remote:\n\e[31m...\e[0m \e[1m%s\e[0m' "$(git remote get-url upstream)"
	else
		read -r user < <("$provider.user" "$domain")
		if [[ $user ]]; then
			read -r org < <(get_config "$domain/$user" org)
			message '\e[32m\e[1m > \e[0mUser: \e[1m%s\e[0m on \e[1m%s\e[0m...' "$user" "$domain"
			message '\e[32m\e[1m + \e[0mRepo: \e[1m%s\e[0m' "$(
				git remote get-url origin \
					| repostrip '[:/]/?'
			)"
			if git remote | grep -xqw upstream; then
				message '\e[32m\e[1m + \e[0mUpstream: \e[1m%s\e[0m' "$(
					git remote get-url upstream \
						| repostrip '[:/]/?'
				)"
			fi

		else
			message '\e[31m\e[1m ! \e[0mFailed to authenticate on \e[1m%s\e[0m...' "$domain"
			exit 1
		fi
	fi
elif ! git remote | grep -xqw upstream; then
	trap 'rollback_failure' INT TERM QUIT EXIT
	git remote rename origin upstream

	read -r provider domain remote < <(identify_remote upstream)
	if [[ $provider == unknown ]]; then
		message '\e[31m\e[1m ! \e[0mUnknown remote:\n\e[31m...\e[0m \e[1m%s\e[0m' "$(git remote get-url upstream)"
	else
		create_fork "$provider" "$domain" "$remote" "$@"
	fi

	rollback_failure
	fork_setup
elif git remote | grep -xqw upstream; then
	message '\e[33m\e[1m > \e[0mUpstream configured...'

	read -r provider domain remote < <(identify_remote upstream)
	if needs_post "$provider"; then
		read -r user < <("$provider.user" "$domain")
		if [[ $user ]]; then
			read -r org < <(get_config "$domain/$user" org)
			read -r repo < <(git remote get-url origin | repostrip '.+/')
			message '\e[32m\e[1m + \e[0mApplying post-fork configurations...'
			"$provider.post" "$domain" "${org:-$user}" "$repo"
		fi
	fi

	fork_setup
else
	message '\e[31m\e[1m ! \e[0mNo upstream found...'
fi
